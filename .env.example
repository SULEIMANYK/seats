# ── Supabase ────────────────────────────────────────────────────────────────
# Project settings → API.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Service role key. Server-only — it bypasses row-level security, so it must
# never be exposed to the browser or committed.
SUPABASE_SERVICE_ROLE_KEY=
# Anon key. Safe to expose; RLS is on with no public write policies.
SUPABASE_ANON_KEY=

# The same two values again, under NEXT_PUBLIC_ names, because the sign-in
# form runs in the browser and can only read NEXT_PUBLIC_* vars. These are
# inlined at build time, so changing them needs a rebuild to take effect.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── App ─────────────────────────────────────────────────────────────────────
# Random string; salts the hashed IPs used for click tracking and rate limits.
CLICK_SALT=
# Random string; the Bearer token guarding /api/cron/snapshot. Vercel sends it
# automatically for scheduled runs once it is set here.
CRON_SECRET=
# The secret that opens /admin?key=... There are no accounts, so this is the
# whole gate. Unset renders /admin as a plain 404 rather than opening it.
ADMIN_KEY=
