# ── Supabase ────────────────────────────────────────────────────────────────
# Project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Service role key. Server-only — every query in this app runs on the server,
# and RLS is enabled with no public policies.
SUPABASE_SERVICE_ROLE_KEY=

# ── Polar ───────────────────────────────────────────────────────────────────
# Organization access token: polar.sh → Settings → Developers
POLAR_ACCESS_TOKEN=
# Set to "sandbox" while testing, remove for production
POLAR_SERVER=sandbox
# Settings → Webhooks → add endpoint https://your-domain/api/webhooks/polar
# Subscribe to: subscription.active, subscription.updated, subscription.canceled,
# subscription.uncanceled, subscription.past_due, subscription.revoked, order.paid
POLAR_WEBHOOK_SECRET=
# Generated by `npm run setup:products`
POLAR_PRODUCT_IDS=

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Random string; salts the hashed IPs used for click tracking
CLICK_SALT=
# Random string; Bearer token guarding /api/cron/grace
CRON_SECRET=
